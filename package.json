{
  "name": "reliefgrid-server",
  "version": "1.0.0",
  "type": "module",
  "description": "ReliefGrid Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc --noEmit -p scripts/tsconfig.json",
    "test": "tsx --test src/modules/*/*.test.ts scripts/*.test.ts",
    "start": "node dist/server.js",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "smoke:demo": "tsx scripts/smoke-demo.ts",
    "smoke:allocation": "tsx scripts/smoke-allocation.ts",
    "consolidate:demo": "tsx scripts/consolidate-demo.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.7.27",
    "better-auth": "^1.7.27",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "file-type": "^22.3.0",
    "jose": "^6.2.18",
    "mongodb": "^7.9.1",
    "multer": "^2.5.0",
    "pdfkit": "^0.21.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
